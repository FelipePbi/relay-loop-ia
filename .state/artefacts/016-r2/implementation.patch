+  background: var(--surface);
+}
+.directory-form-card h2 {
+  margin-bottom: 18px;
+  font-size: 18px;
+}
+.directory-form-grid {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 18px 16px;
+}
+.directory-form-grid .is-wide {
+  grid-column: 1 / -1;
+}
+.directory-form-card textarea {
+  min-height: 96px;
+  padding-block: 12px;
+  resize: vertical;
+}
+.directory-fieldset {
+  min-width: 0;
+  margin: 0;
+  padding: 0;
+  border: 0;
+}
+.directory-fieldset legend {
+  margin-bottom: 9px;
+  font-size: 14px;
+  font-weight: 600;
+}
+.directory-segmented {
+  display: grid;
+  grid-template-columns: 1fr 1fr;
+  gap: 8px;
+}
+.directory-segmented label {
+  position: relative;
+}
+.directory-segmented input {
+  position: absolute;
+  opacity: 0;
+}
+.directory-segmented span {
+  min-height: 48px;
+  padding: 0 12px;
+  border: 1px solid var(--border-strong);
+  border-radius: 10px;
+  display: grid;
+  place-items: center;
+  color: var(--fg-soft);
+  background: var(--surface);
+  font-size: 13px;
+  font-weight: 600;
+  cursor: pointer;
+}
+.directory-segmented input:checked + span {
+  color: var(--accent);
+  border-color: var(--accent);
+  background: var(--accent-soft);
+}
+.directory-segmented input:focus-visible + span {
+  outline: 2px solid var(--accent);
+  outline-offset: 3px;
+}
+.directory-form-note {
+  padding: 12px 14px;
+  border-radius: var(--r-input);
+  color: var(--muted);
+  background: var(--surface-interactive);
+  font-size: 12px;
+}
+.directory-active-control {
+  min-height: 68px;
+  padding: 12px 14px;
+  align-items: center;
+  border: 1px solid var(--border);
+  border-radius: var(--r-input);
+  background: var(--surface-secondary);
+}
+.directory-active-copy {
+  min-width: 0;
+  display: grid;
+  gap: 2px;
+}
+.directory-active-copy strong,
+.directory-active-copy .field-help {
+  display: block;
+}
+.directory-form-footer {
+  margin-top: 24px;
+  padding-top: 20px;
+  border-top: 1px solid var(--border);
+  display: flex;
+  align-items: center;
+  justify-content: flex-end;
+  gap: 10px;
+}
+.directory-inline-error {
+  margin-top: 16px;
+  padding: 12px 14px;
+  border: 1px solid color-mix(in oklch, var(--danger), white 68%);
+  border-radius: var(--r-input);
+  color: var(--danger);
+  background: var(--danger-soft);
+  font-size: 13px;
+}
+
+@media (max-width: 1099px) {
+  .service-grid {
+    grid-template-columns: minmax(200px, 1.25fr) 100px 130px 120px 44px;
+  }
+  .service-grid > :nth-child(5) {
+    display: none;
+  }
+}
+
+@media (max-width: 767px) {
+  .directory-toolbar {
+    grid-template-columns: 1fr;
+    gap: 12px;
+  }
+  .directory-filters {
+    justify-content: flex-start;
+    margin-inline: -16px;
+    padding-inline: 16px;
+  }
+  .directory-list-surface,
+  .directory-state-surface {
+    margin-inline: -16px;
+    border-inline: 0;
+    border-radius: 0;
+  }
+  .directory-grid-head {
+    display: none;
+  }
+  .directory-list-meta {
+    padding-inline: 16px;
+  }
+  .directory-row.service-grid {
+    min-height: 0;
+    padding: 16px;
+    grid-template-columns: minmax(0, 1fr) auto;
+    gap: 12px 10px;
+  }
+  .directory-row.service-grid > :nth-child(5) {
+    display: grid;
+  }
+  .directory-row-main {
+    grid-column: 1;
+  }
+  .directory-row-action {
+    grid-column: 2;
+    grid-row: 1;
+    align-self: center;
+  }
+  .directory-cell {
+    display: grid !important;
+    gap: 2px;
+  }
+  .directory-cell-label {
+    display: block;
+  }
+  .service-grid .directory-cell:nth-child(2),
+  .service-grid .directory-cell:nth-child(3) {
+    grid-column: auto;
+  }
+  .service-grid .directory-cell:nth-child(4),
+  .service-grid .directory-cell:nth-child(5) {
+    grid-column: span 2;
+  }
+  .directory-state-surface {
+    min-height: 470px;
+  }
+  .directory-form-card {
+    padding: 20px 16px;
+  }
+  .directory-form-grid {
+    grid-template-columns: 1fr;
+  }
+  .directory-form-grid .is-wide {
+    grid-column: auto;
+  }
+  .directory-form-footer {
+    flex-direction: column-reverse;
+  }
+  .directory-form-footer .btn {
+    width: 100%;
+  }
+}
+
+@media (max-width: 390px) {
+  .directory-segmented {
+    grid-template-columns: 1fr;
+  }
+}
+
+@media (prefers-reduced-motion: reduce) {
+  .directory-row,
+  .directory-filter {
+    transition: none;
+  }
+}
