+}
+.directory-row-main {
+  min-width: 0;
+  display: flex;
+  align-items: center;
+  gap: 11px;
+}
+.directory-row-copy {
+  min-width: 0;
+  display: grid;
+  gap: 2px;
+}
+.directory-row-copy strong {
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font-size: 14px;
+}
+.directory-row-copy span,
+.directory-cell {
+  color: var(--muted);
+  font-size: 13px;
+}
+.directory-cell strong {
+  color: var(--fg);
+  font-weight: 600;
+}
+.directory-cell-label {
+  display: none;
+  color: var(--muted);
+  font-size: 11px;
+}
+.directory-row-action {
+  justify-self: end;
+  color: var(--muted);
+}
+.directory-row-badges {
+  display: flex;
+  flex-wrap: wrap;
+  gap: 6px;
+}
+.directory-no-results {
+  padding: 56px 20px;
+  color: var(--muted);
+  text-align: center;
+}
+.directory-state-surface {
+  min-height: 500px;
+  border: 1px solid var(--border);
+  border-radius: var(--r-card);
+  display: grid;
+  place-items: center;
+  background: var(--surface);
+}
+.directory-state-surface .empty-state,
+.directory-state-surface .error-state {
+  padding: 56px 24px;
+}
+.directory-state-surface h2 {
+  margin-bottom: 8px;
+  font-size: 22px;
+}
+.directory-retry-status {
