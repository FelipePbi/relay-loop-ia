+  if (pendingAction && typeof pendingAction === "object") {
+    const pending = pendingAction as Record<string, unknown>;
+    if (typeof pending.serviceId === "string" || typeof pending.serviceId === "number") {
+      ids.add(String(pending.serviceId));
