+    id: item.id,
+    category: item.category,
+    externalId: item.externalId,
+    label: item.label,
+    status: item.status,
+    reasonCode: item.reasonCode,
+    reasonDetail: item.reasonDetail,
+    entityType: item.entityType,
+    internalId: item.internalId,
