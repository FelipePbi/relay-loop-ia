+  prisma: PrismaClient,
+  input: {
+    tenantId: string;
+    sessionId: string;
+    itemId: string;
+    decidedBy: string;
+    decision:
+      | "INCLUDE"
+      | "EXCLUDE"
+      | "MERGE_WITH_EXISTING"
+      | "CREATE_NEW"
+      | "KEEP_EXISTING";
+    targetInternalId?: string;
+    noteCode?: string;
+  },
+): Promise<Record<string, unknown>> {
+  const session = await requireImportSession(
+    prisma,
+    input.tenantId,
+    input.sessionId,
+  );
