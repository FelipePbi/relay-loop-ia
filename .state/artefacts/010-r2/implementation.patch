+async function requireImportSession(
+  prisma: PrismaClient,
+  tenantId: string,
+  sessionId: string,
+) {
+  const session = await prisma.importSession.findUnique({
+    where: { tenantId_id: { tenantId, id: sessionId } },
+  });
+  if (!session) {
+    throw new AppError(
+      "IMPORT_SESSION_NOT_FOUND",
+      "Import session was not found.",
+      404,
+    );
+  }
+  return session;
+}
