+function StatusLine({
+  activeCopy,
+  label,
+  offCopy,
+  view,
+}: {
+  activeCopy: string;
+  label: string;
+  offCopy: string;
+  view: "active" | "loading" | "off" | "unknown";
+}) {
+  const copy =
+    view === "loading"
+      ? `Verificando ${label}`
+      : view === "unknown"
+        ? `${label} não confirmado`
+        : view === "active"
+          ? activeCopy
+          : offCopy;
+  return (
+    <div className="status-line" role="status">
+      <span
+        className={clsx(
+          "status-dot",
+          view === "off" && "danger",
+          (view === "loading" || view === "unknown") && "neutral",
+        )}
+        aria-hidden="true"
+      />
+      <span>{copy}</span>
+    </div>
+  );
