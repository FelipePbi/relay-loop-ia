-        name:
-          appointment.serviceName ??
-          appointment.service?.name ??
-          `Servico ${appointment.serviceId}`,
-        durationMinutes: knownPositiveDuration(appointment.service?.duration),
-        priceType: price === null ? "NOT_INFORMED" : "FIXED",
-        price,
-      },
-    ];
-  }
-  return [];
-}
